<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- High sampling rate sensor. This permission ALSO qualifies the health-type foreground
         service, with no runtime prompt and no while-in-use restriction: that is what makes the
         restart after reboot legal, since it starts from the background. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- DO NOT declare BODY_SENSORS: it is subject to while-in-use, it would break the restart
         from the background, and no body sensor is read.
         DO NOT declare INTERNET: its absence is a verifiable guarantee — nothing recorded here
         can leave the watch/phone pair.
         DO NOT declare SCHEDULE_EXACT_ALARM: see Watchdog.kt, the trade-off is accepted.
         Fallback only if starting the health FGS were refused on a device:
         <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" /> -->

    <!--
      `icon` points at the adaptive icon and **no longer** at `@drawable/ic_pendulum`. That 24 dp
      vector is designed for the small notification icon — white on transparent, no background, no
      safe zone — and the Wear OS launcher applies a circular mask: a white stroke with no
      background became a dot there. `ic_pendulum` stays, and serves exactly what it is made for:
      `setSmallIcon` in `RecordingService`.

      Intended side effect: the WO-V15 quality requirement asks that the splash screen icon be
      identical to the launcher one, which the adaptive icon satisfies on its own.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Pendulum">

        <!-- The application depends on the phone module (evening context, ingestion): it is not
             standalone, and declaring so avoids passing it off as such. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name="com.pendulum.wear.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.pendulum.wear.record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="health"
            android:stopWithTask="false" />

        <!--
          Data Layer reception on the watch side: acknowledgements, sweep requests, start requests.

          **No `android:permission`, and that is measured.** The exact mirror of the `:phone`
          module's service: the `android:permission="…BIND_WEARABLE_LISTENER"` line that used to be
          here forbade every delivery, because Play Services does not request that permission and
          therefore cannot hold it, whatever `protectionLevel` one might define it under oneself.
          The refusal is silent as far as the application is concerned. What protects the service
          in its place is the library's UID filter, which rejects any caller that is not GMS before
          `onDataChanged` is reached. `BENCH-LOG.md` §12.1.
        -->
        <service
            android:name="com.pendulum.wear.transfer.AckObserver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pendulum/ack" />
            </intent-filter>
            <!--
                The erase order, and it needs its own filter.

                Play Services only delivers `DATA_CHANGED` for the paths a filter names, so
                `AckObserver.onDataChanged` can handle `/pendulum/erase` all it likes: without this
                block the item is put by the phone, replicated to the watch, and never delivered to
                anybody. The night would go on being recorded and would re-announce itself at its
                close, which is exactly the defect the erase order exists to close.

                This is the same failure mode as the one `ComponentPermissionsTest` was written for:
                the code is right, the manifest makes it unreachable, and nothing says so — no
                exception, no message, just a feature that quietly does nothing.

                An exact path and not a prefix: `/pendulum/erase` carries no identifier, unlike the
                per-session paths beside it.
            -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/pendulum/erase" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pendulum/sweep-request" />
            </intent-filter>

            <!--
              Start request coming from the phone. The service attempts `startForegroundService`
              and falls back to a notification when Android refuses it — it is started by GMS, so
              from the background, where Android 12 forbids starting a foreground service outside
              the exemptions.
            -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pendulum/start-request" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.pendulum.wear.record.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
