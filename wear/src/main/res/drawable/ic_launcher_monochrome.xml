<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer — **it is not optional.**

  Since Android 16 QPR2, icon theming is forced and the application cannot opt out. Without this
  layer the system builds a themed version itself by filtering the colours of the foreground
  layer, and the result is a rough flat shape. Supplying it is the only way to decide one's own
  silhouette.

  Same geometry as `ic_launcher_foreground`, in solid white: the system tints, and the alpha that
  sets the arc apart in the foreground layer would disappear under the tint anyway. The arc
  therefore keeps its recessive reading through stroke width alone, not through transparency.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M38.61,69.29 A45,45 0 0 0 69.39,69.29"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2.5" />

    <path
        android:pathData="M54,27 L69.39,69.29"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,27 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M69.39,69.29 m-9.5,0 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0" />

</vector>
