<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Background of the adaptive icon. This is `background` from the dark palette
      (`ui/theme/PendulumColors.kt`, `Color(0xFF0E1116)`), not a colour chosen separately: the
      icon sitting next to the application's screen must be the same black, otherwise the two
      contradict each other. The drawing itself is `accent` (`Color(0xFF6FB2FF)`).

      A flat colour and not a gradient: the layers of an adaptive icon are scaled and offset by
      the launcher for the parallax effect, and a gradient starts sliding under the mask when the
      icon moves.
    -->
    <color name="ic_launcher_background">#0E1116</color>
</resources>
