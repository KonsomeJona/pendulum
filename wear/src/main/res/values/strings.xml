<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Pendulum</string>

    <!-- Ongoing notification. IMPORTANCE_LOW channel: no sound, no vibration. -->
    <string name="notif_channel_name">Night recording</string>
    <string name="notif_channel_description">Shows that accelerometer capture is running. No sound, no vibration.</string>
    <string name="notif_title">Recording the night</string>
    <string name="notif_text">%1$s · %2$s MB · battery %3$d %%</string>
    <string name="notif_text_finalizing">Closing the night…</string>

    <!-- Single screen: stopped state. -->
    <string name="idle_title">Ready</string>

    <!--
         The title when a blocker forbids the start.

         "Ready" was rendered unconditionally, so above "the watch will not start until it is
         sealed" and above a greyed-out START: the screen claimed to be ready and to refuse to
         start, at the same time. The comment on `IdleContent` carries the rule, though — blockers
         are the only thing to read when they exist — and a title that contradicts them empties it
         of its meaning.

         Direct negation of the same word rather than a new wording: the user who has learned to
         look for "Ready" at the top of the screen must see in the same place that it is not so.
    -->
    <string name="idle_title_blocked">Not ready</string>
    <string name="start">START</string>
    <string name="battery_line">Battery %1$d%%</string>

    <!--
         The battery before the first sensor reading.

         `RecordUiState.batteryPct` is `-1` as long as no measurement has arrived, and the line
         displayed that fallback as it was: "Battery -1%" during the first seconds of every night.
         The dash is the one the whole rest of the product uses for "not known yet", and it cannot
         be mistaken for any possible value.
    -->
    <string name="battery_line_unknown">Battery —</string>
    <string name="free_space_line">Free space %1$s</string>
    <string name="pending_sync_line">%1$d chunks awaiting sync</string>
    <string name="preflight_recheck">Check again</string>
    <string name="allow_notifications">Allow notifications</string>
    <string name="open_on_phone">Open on phone</string>
    <string name="open_on_phone_sent">Opened on your phone.</string>
    <string name="open_on_phone_unreachable">Phone not reachable. Fill the evening form on it directly.</string>
    <string name="open_settings">Open settings</string>

    <!--
      Notification posted when the phone requests the start and Android refuses to let a service
      started in the background launch a foreground service. The tap is the only reliable exemption
      from that block.
    -->
    <string name="notif_channel_action">Actions requested from your phone</string>
    <string name="notif_ready_title">Context sealed</string>
    <string name="notif_ready_body">Tap to start recording.</string>

    <!-- Single screen: recording state. -->
    <string name="elapsed_hm">%1$d h %2$02d</string>
    <string name="samples_line">%1$s samples</string>
    <string name="written_line">%1$s MB written</string>
    <string name="gaps_line">Gaps: %1$d</string>
    <string name="gaps_line_total">Gaps: %1$d (%2$s missing)</string>
    <string name="mode_line">Mode %1$s</string>
    <string name="sync_line">Sync %1$d/%2$d</string>
    <string name="sync_backlogged">Sync behind — recording carries on to disk</string>
    <string name="stop">STOP</string>
    <string name="stop_hint">Long press to stop</string>
    <string name="stop_confirm">Confirm stopping the night</string>
    <string name="stop_cancel">Carry on recording</string>
    <string name="finalizing">Closing… do not take the watch off</string>

    <!-- Preflight blockers: START is refused, and each message says what to do. -->
    <string name="blocker_context_not_sealed">Fill in the evening form on the phone: the watch will not start until it is sealed.</string>
    <string name="blocker_notifications">Allow notifications, otherwise the system will stop the recording in the middle of the night.</string>
    <string name="blocker_no_accelerometer">Accelerometer unavailable. Restart the watch.</string>
    <string name="blocker_storage_full">Storage full: %1$s free, 300 MB needed. Sync first (%2$s chunks waiting).</string>

    <!--
      The backlog cap, which is not the disk being full.

      Both facts used to raise one issue carrying this file's other message, so a watch with
      several gigabytes free read "Storage full: 4.6 GB free" — disproved by its own figure. This
      one names the real limit and the real remedy: the nights are held here until the phone comes
      and collects them, and no space on the watch will change that.
    -->
    <string name="blocker_backlog_at_cap">Nights already recorded are waiting for the phone (%1$s chunks). Open Pendulum on it, within Bluetooth range, before starting another.</string>
    <string name="blocker_fgs_refused">The watch refuses to start the measurement service. Restart the watch, then try again.</string>
    <!-- Bench build only: never reachable in a release, where the divider is 1. -->
    <string name="blocker_bench_scale">Bench build: wall time is divided by %1$s, but the real sensor is not. Rebuild without -Ppendulum.temps.diviseur, or start with the synthetic source.</string>

    <!-- Warnings: START stays possible, the user decides. -->
    <string name="warning_low_battery">Battery %1$s%% — 50%% recommended for eight hours.</string>
    <string name="warning_phone_unreachable">Phone unreachable — recording carries on, sync will happen later.</string>
    <!--
      Bench build only: never reachable in a release, where `Bench.IGNORE_CHARGER` is a `false`
      constant and the branch disappears at compile time. It says what has changed **and** what the
      night is worth: a night recorded on the charger is not a night.
    -->
    <string name="warning_bench_charger">Bench build: the stop on charger is disabled. This recording is a test, not a night.</string>
    <string name="warning_no_wakeup_sensor">No wake-up sensor: wake lock mode, shorter battery life.</string>
    <string name="warning_pending_sync">%1$s chunks from an earlier night are still waiting for the phone.</string>

    <!-- End of session. -->
    <string name="stopped_charging">Recording stopped: watch on the charger.</string>
    <string name="stopped_low_battery">Recording stopped: battery under 5 %%. Everything recorded has been sent.</string>
    <string name="stopped_time_limit">Recording stopped: cut-off time reached.</string>
    <string name="stopped_max_duration">Recording stopped: maximum duration reached.</string>
    <string name="stopped_wake">Recording stopped: waking detected.</string>
    <string name="stopped_disk_full">Recording stopped: disk full. The night recorded is intact.</string>
    <string name="stopped_crash">The watch restarted. The previous night was closed and sent.</string>
</resources>
