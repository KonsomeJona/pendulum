<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante ronde. Contenu identique a `ic_launcher.xml`, et c'est normal : le masque est applique
  par le lanceur, pas par la ressource. `android:roundIcon` reste declare au manifeste parce que
  certains lanceurs la reclament explicitement, et son absence les fait retomber sur l'icone par
  defaut du systeme.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
