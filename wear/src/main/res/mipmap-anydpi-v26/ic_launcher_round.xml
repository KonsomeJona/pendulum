<?xml version="1.0" encoding="utf-8"?>
<!--
  Round variant. Contents identical to `ic_launcher.xml`, and that is expected: the mask is
  applied by the launcher, not by the resource. `android:roundIcon` stays declared in the
  manifest because some launchers ask for it explicitly, and its absence makes them fall back on
  the system default icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
