<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon, entirely vector and without a single PNG.

  The density PNGs (`mipmap-mdpi` to `mipmap-xxxhdpi`) only serve as a fallback under Android 8,
  where the adaptive icon does not exist. `minSdk` is 33 here: that fallback is dead, and
  declaring it would pull five bitmaps into the APK that nothing ever reads.

  This file is identical to the one in the `:phone` module, duplicated on purpose: there is no
  shared resource module between the two applications, and creating one for five files would
  cost more than the duplication. If the drawing changes on one side, change it on the other.

  On Wear OS the mask is **always circular** — there is no squircle or teardrop to plan for, but
  nothing sticks out of the circle either. The 66 dp safe zone respected by
  `ic_launcher_foreground` is therefore a strict constraint here, not a precaution.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
