<?xml version="1.0" encoding="utf-8"?>
<!--
  Couche avant de l'icone adaptative. **Viewport 108, tout le trace dans le cercle central de
  66 dp.**

  Les 18 dp de marge sur chaque bord ne sont pas de la coquetterie : le masque appartient au
  constructeur, pas a nous — cercle, squircle, goutte, cercle strict sur Wear OS — et le lanceur
  applique en plus un decalage de parallaxe. Tout ce qui sort du cercle de 66 dp peut disparaitre
  sur un appareil qu'on n'a pas teste. La verification tient en une ligne : la distance de chaque
  point au centre (54, 54) doit rester sous 33.

    pivot  (54, 27)              distance 27
    lentille  centre (69,4 ; 69,3) rayon 9,5   distance 21,7 + 9,5 = 31,2
    arc  bas (54, 72)            distance 18

  Le dessin est un pendule ecarte de 20 degres, avec l'arc de sa course. Le choix du sujet n'est
  pas decoratif : la periode d'un pendule ne depend pas de l'amplitude de son ecart, et c'est
  exactement l'argument du produit — le rythme entre les mouvements est stable la ou leur compte
  ne l'est pas. L'arc porte l'amplitude, la tige porte la periode.

  Aucune ombre, aucun degrade, aucun masque pre-applique : le lanceur s'en charge, et un asset
  qui les embarque se retrouve avec deux ombres.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- L'arc de course, en retrait : c'est l'amplitude, et l'amplitude est ce que le produit
         ecarte au profit de la periode. Il doit se lire, pas dominer. -->
    <path
        android:pathData="M38.61,69.29 A45,45 0 0 0 69.39,69.29"
        android:strokeAlpha="0.55"
        android:strokeColor="#6FB2FF"
        android:strokeLineCap="round"
        android:strokeWidth="3" />

    <!-- La tige. -->
    <path
        android:pathData="M54,27 L69.39,69.29"
        android:strokeColor="#6FB2FF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- Le pivot. -->
    <path
        android:fillColor="#6FB2FF"
        android:pathData="M54,27 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />

    <!-- La lentille. -->
    <path
        android:fillColor="#6FB2FF"
        android:pathData="M69.39,69.29 m-9.5,0 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0" />

</vector>
