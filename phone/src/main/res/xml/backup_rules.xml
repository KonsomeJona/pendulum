<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 backup rules (`android:fullBackupContent`).

  `minSdk` is 30: Android 11 and 12 are in the field, and on Android 11 it is this file that is
  read, not `data_extraction_rules.xml`. With `allowBackup="false"` it should never serve — it is
  here so that an `allowBackup` set back to `true` by accident in a manifest merge is not enough
  on its own to exfiltrate the database.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
