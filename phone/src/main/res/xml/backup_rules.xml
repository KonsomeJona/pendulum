<?xml version="1.0" encoding="utf-8"?>
<!--
  Regles de sauvegarde pre-Android 12 (`android:fullBackupContent`).

  `minSdk` vaut 30 : Android 11 et 12 sont dans le parc, et sur Android 11 c'est ce fichier-ci
  qui est lu, pas `data_extraction_rules.xml`. Avec `allowBackup="false"` il ne devrait jamais
  servir — il est la parce qu'un `allowBackup` remis a `true` par megarde dans un merge de
  manifeste ne doit pas suffire a exfiltrer la base.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
