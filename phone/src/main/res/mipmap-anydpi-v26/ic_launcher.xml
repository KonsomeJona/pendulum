<?xml version="1.0" encoding="utf-8"?>
<!--
  Icone de lanceur, entierement vectorielle et sans le moindre PNG.

  Les PNG de densite (`mipmap-mdpi` a `mipmap-xxxhdpi`) ne servent que de repli sous Android 8,
  ou l'icone adaptative n'existe pas. `minSdk` vaut 30 ici : ce repli est mort, et le declarer
  ferait entrer dans l'APK cinq bitmaps que rien ne lit jamais.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
