<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest of `:sleepwriter`, the bench's hypnogram writer.

  ### Why this application is allowed to write when Pendulum is not

  In the real world the hypnogram is written by a third-party application — ring, wrist watch,
  under-mattress sensor — and Pendulum only reads it. It is the "denominator" half of the
  measurement, and the product rests on that half coming from **a sensor other than its own**:
  if both came from the same accelerometer, a processing step that removes movement would lower
  the numerator and raise the denominator in the same stroke (`docs/01-overview.md` §1).

  This application is therefore the faithful counterpart of that separation, not a way around it.
  It shares neither Pendulum's package, nor its process, nor its database: it really is another
  application, which is exactly what the bench has to simulate.

  `:phone` only declares `READ_SLEEP`, `READ_HEALTH_DATA_IN_BACKGROUND` and
  `READ_HEALTH_DATA_HISTORY`, and that must never change. See the `androidComponents` comment in
  `build.gradle.kts`: this module has no release variant.

  ### `READ_SLEEP` here too, and it is not a contradiction

  The `verify` mode reads back what has just been written so that a script can know whether the
  write succeeded without looking at the screen. Health Connect does not grant reading on the
  strength of writing: without `READ_SLEEP`, `readRecords` fails even on one's own records.
  Verification would then be impossible other than by eye, which is precisely what we want to
  avoid.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!--
      Package visibility. Without this declaration, `HealthConnectClient.getSdkStatus()` returns
      `SDK_UNAVAILABLE` on Android 11+ **even though Health Connect is installed**: package query
      filtering simply prevents seeing it. The symptom is a false negative, not an error.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
          The one and only activity. `exported="true"` is a requirement of the bench and not an
          oversight: it is `adb shell am start -n
          <package>/com.pendulum.sleepwriter.SleepWriterActivity` that launches it, and a
          non-exported activity refuses a start coming from the shell (`SecurityException`,
          "not exported from uid").

          The class name is **absolute**. A relative name (`.SleepWriterActivity`) resolves against
          `applicationId`, which here is `com.pendulum.sleepwriter.a` or `.b` depending on the
          variant, whereas the class lives in `com.pendulum.sleepwriter`: the manifest would merge
          without saying anything and the activity would be unreachable at runtime.

          MAIN/LAUNCHER is kept for the one gesture the bench cannot script reliably: granting the
          permission by hand when the UiAutomator sequence fails.
        -->
        <activity
            android:name="com.pendulum.sleepwriter.SleepWriterActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Health Connect permissions rationale — **two mandatory declarations**, the same pair the
          `:phone` manifest documents.

          The `androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE` path is the one of the Health
          Connect APK (Android 13 and earlier); the `ViewPermissionUsageActivity` alias is the one
          of the framework (Android 14+, Health Connect built into the system). With `minSdk 30`
          both halves of the fleet exist, and declaring only one makes Health Connect **refuse to
          show the application in its list**: the symptom is an absence, not an error.

          This is not cosmetics for a bench tool — that list is how `WRITE_SLEEP` gets granted by
          hand when driving through UiAutomator fails.
        -->
        <activity
            android:name="com.pendulum.sleepwriter.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="com.pendulum.sleepwriter.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
